// Modèle de données d'Open Space Simulator.
// Après modification : `pnpm db:migrate` (crée une migration et régénère le client).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Locale {
  fr
  en
}

enum GameMode {
  EASY
  NORMAL
  HARDCORE
  INTERNS_ONLY
  SHIP_IN_3
  DAILY
}

enum Phase {
  GARAGE
  SEED
  SERIES_A
  UNICORN
  END
}

enum Outcome {
  BANKRUPTCY
  IPO
  ACQUISITION
  ZOMBIE
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  /// Absent pour un compte créé uniquement via GitHub.
  passwordHash String?
  githubId     String?  @unique
  pseudo       String   @unique
  role         Role     @default(USER)
  locale       Locale   @default(fr)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens RefreshToken[]
  saves         Save[]
  scores        Score[]
  achievements  UserAchievement[]
  aiQuotas      AiQuota[]
}

/// Refresh token opaque : seul son empreinte SHA-256 est stockée.
/// Rotation à chaque usage ; la réutilisation d'un jeton révoqué révoque toute la session.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Emplacement de 1 à 5.
  slot      Int
  state     Json
  /// Journal des commandes depuis le début de la partie (replays, publication du score).
  commandsLog Json @default("[]")
  seed      String
  mode      GameMode
  /// Version du jeu de cartes avec lequel la partie a commencé (voir CardSet).
  cardsVersion String @default("builtin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slot])
}

model EventCard {
  id         String   @id
  /// { title: {fr, en}, description: {fr, en} }
  content    Json
  conditions Json
  choices    Json
  weight     Int      @default(1)
  cooldown   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  stats EventStat[]
}

model Score {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          GameMode
  /// Valorisation finale en euros (peut dépasser la capacité d'un Int 32 bits).
  valuation     Float
  outcome       Outcome
  /// Phase atteinte avant la fin : alimente le « taux de faillite par phase » du back-office.
  phaseReached  Phase
  sprintsPlayed Int
  seed          String
  /// Liste des commandes du joueur : permet le rejeu côté serveur (anti-triche) et les replays.
  commandsLog   Json
  /// Jeu de cartes utilisé (indispensable pour rejouer la partie à l'identique).
  cardsVersion  String
  cardSet       CardSet   @relation(fields: [cardsVersion], references: [version])
  /// Statistiques de fin de partie (GameStats) : profil et statistiques cumulées.
  stats         Json
  dailyDate     DateTime? @db.Date
  createdAt     DateTime  @default(now())

  /// Un seul essai par jour au Daily (les NULL des autres modes ne se gênent pas).
  @@unique([userId, dailyDate])
  @@index([mode, valuation])
  @@index([dailyDate, valuation])
  @@index([userId])
}

/// Instantané d'un jeu de cartes, identifié par l'empreinte de son contenu. Une partie ne
/// retient que l'identifiant de cette version : le serveur peut la rejouer même si un
/// administrateur a modifié les cartes depuis.
model CardSet {
  version   String   @id
  cards     Json
  createdAt DateTime @default(now())

  scores Score[]
}

model Achievement {
  id          String @id
  title       Json
  description Json
  icon        String

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@id([userId, achievementId])
}

model EventStat {
  cardId      String
  card        EventCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  choiceIndex Int
  count       Int       @default(0)

  @@id([cardId, choiceIndex])
}

/// Quota quotidien d'appels au Slack IA par utilisateur.
model AiQuota {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  count  Int      @default(0)

  @@id([userId, date])
}

/// Pack de personnages thématiques (Noël, Halloween…) activé ou non depuis le back-office.
/// Un pack sans ligne garde son état par défaut (« Base » actif, les autres non).
model CharacterPack {
  id        String   @id
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Thème de décoration de saison (Noël, Halloween…) réglé depuis le back-office :
/// OFF (jamais), SEASON (pendant sa période) ou ALWAYS (en permanence).
/// Un thème sans ligne garde le réglage par défaut, SEASON.
model DecorTheme {
  id        String   @id
  mode      String   @default("SEASON")
  updatedAt DateTime @updatedAt
}
