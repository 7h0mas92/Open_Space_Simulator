# ─────────────────────────────────────────────────────────────────────────────
# Variables d'environnement du serveur Open Space Simulator.
# Copier ce fichier en `.env` (jamais commité) puis adapter les valeurs.
#   cp packages/server/.env.example packages/server/.env
# ─────────────────────────────────────────────────────────────────────────────

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Base PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://oss:oss@localhost:5432/oss

# Secret de signature des JWT et des cookies : 32 caractères minimum.
# Générer une valeur : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-change-me-change-me-change-me
# Durée de vie du JWT d'accès (secondes) et du refresh token (jours)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Cookies "Secure" (HTTPS uniquement). Par défaut : true en production, false sinon.
# COOKIE_SECURE=true

# URL publique du client (redirections après connexion GitHub)
CLIENT_URL=http://localhost:5173
# Origines CORS autorisées, séparées par des virgules (par défaut : CLIENT_URL)
# CORS_ORIGINS=http://localhost:5173,https://open-space-simulator.vercel.app

# Requêtes par minute et par IP : global, puis routes de connexion / inscription
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# Connexion GitHub (facultative). Créer une OAuth App :
#   https://github.com/settings/developers → New OAuth App
#   Authorization callback URL : http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Par défaut : ${CLIENT_URL}/api/auth/github/callback
# GITHUB_CALLBACK_URL=

# Compte administrateur créé par `pnpm db:seed` (mot de passe obligatoire en production)
SEED_ADMIN_EMAIL=admin@oss.local
SEED_ADMIN_PASSWORD=admin-dev-password

# Slack piloté par l'IA (facultatif). La clé ne quitte jamais le serveur ; sans clé,
# POST /api/slack-ai/message répond 503 AI_UNAVAILABLE et le jeu garde ses templates.
# Clé : https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modèle utilisé pour écrire les messages
ANTHROPIC_MODEL=claude-opus-5-5
# Appels IA par joueur et par jour, et durée du cache des réponses (secondes)
AI_DAILY_QUOTA=40
AI_CACHE_TTL_SECONDS=3600
