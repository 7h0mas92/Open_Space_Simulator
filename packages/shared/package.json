{
  "name": "@oss/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types TypeScript et schémas Zod partagés entre le client et le serveur.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
