{
  "name": "open-space-simulator",
  "version": "0.1.0",
  "private": true,
  "description": "Open Space Simulator 2026 : jeu de gestion de startup en 3D isométrique.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @oss/shared build && pnpm --parallel --filter @oss/shared --filter @oss/server --filter @oss/client dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @oss/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @oss/shared build && pnpm -r test",
    "test:e2e": "pnpm --filter @oss/client test:e2e",
    "balance": "pnpm --filter @oss/shared build && pnpm --filter @oss/client balance",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @oss/server db:migrate",
    "db:seed": "pnpm --filter @oss/shared build && pnpm --filter @oss/server db:seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
